#include <windows.h>
#include "src/ResourceIds.h"

// Application manifest
1 24 "app.manifest"

// Application icon
IDI_APP_ICON           ICON   "AndroidDisplay.ico"

// Version information
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Nisanth Noel"
            VALUE "FileDescription", "Android Display"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "AndroidDisplay"
            VALUE "LegalCopyright", "Copyright (C) 2026 Nisanth Noel"
            VALUE "OriginalFilename", "AndroidDisplay.exe"
            VALUE "ProductName", "Android Display"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Bundled ADB & display server resources
IDR_ADB_EXE            RCDATA "platform-tools\\adb.exe"
IDR_ADB_WIN_API        RCDATA "platform-tools\\AdbWinApi.dll"
IDR_ADB_WIN_USB_API    RCDATA "platform-tools\\AdbWinUsbApi.dll"
IDR_DISPLAY_SERVER_JAR RCDATA "server\\android-display-server.jar"
